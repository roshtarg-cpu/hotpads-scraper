{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": {
      "type": "string",
      "title": "Listing URL"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "price": {
      "type": "number",
      "title": "Monthly Rent"
    },
    "bedrooms": {
      "type": "number",
      "title": "Bedrooms"
    },
    "bathrooms": {
      "type": "number",
      "title": "Bathrooms"
    },
    "sqft": {
      "type": "number",
      "title": "Square Feet"
    },
    "propertyType": {
      "type": "string",
      "title": "Property Type"
    },
    "imageUrl": {
      "type": "string",
      "title": "Image URL"
    },
    "propertyDescription": {
      "type": "string",
      "title": "Property Description"
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["address", "price", "bedrooms", "bathrooms", "sqft", "url"]
      },
      "display": {
        "component": "table",
        "properties": {
          "address": {
            "label": "Address",
            "format": "text"
          },
          "price": {
            "label": "Price",
            "format": "number"
          },
          "bedrooms": {
            "label": "Beds",
            "format": "number"
          },
          "bathrooms": {
            "label": "Baths",
            "format": "number"
          },
          "sqft": {
            "label": "Sqft",
            "format": "number"
          },
          "url": {
            "label": "URL",
            "format": "link"
          }
        }
      }
    }
  }
}
